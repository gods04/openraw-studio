{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openraw.studio/schemas/processing_recipe.v1.json",
  "title": "OpenRAW Studio Processing Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "created_at",
    "source",
    "processing_profile",
    "creative_look",
    "analysis",
    "decisions",
    "adjustments",
    "engines",
    "exports"
  ],
  "properties": {
    "schema_version": {
      "const": "recipe.v1"
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "immutable"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "checksum_sha256": { "type": ["string", "null"] },
        "immutable": { "const": true },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "processing_profile": {
      "type": "string",
      "minLength": 1
    },
    "creative_look": {
      "type": "string",
      "minLength": 1
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenes", "faces", "quality"],
      "properties": {
        "scenes": {
          "type": "array",
          "items": { "$ref": "#/$defs/classification" }
        },
        "faces": {
          "type": "array",
          "items": { "$ref": "#/$defs/face" }
        },
        "quality": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": true,
      "required": ["confidence", "rationale"],
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "array", "items": { "type": "string" } }
      }
    },
    "adjustments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "portrait", "color", "film"],
      "properties": {
        "raw": {
          "type": "object",
          "additionalProperties": true
        },
        "portrait": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global", "faces"],
          "properties": {
            "global": { "type": "object", "additionalProperties": true },
            "faces": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["face_id"],
                "properties": {
                  "face_id": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "color": {
          "type": "object",
          "additionalProperties": true
        },
        "film": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "engines": {
      "type": "array",
      "items": { "$ref": "#/$defs/engine" }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "format"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "enum": ["jpeg", "tiff"] }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 }
      }
    },
    "planned_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": true
    },
    "qc": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": true,
      "required": ["label", "confidence"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": true,
      "required": ["face_id", "confidence"],
      "properties": {
        "face_id": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "distance_class": {
          "type": "string",
          "enum": ["close", "mid", "far", "tiny", "unknown"]
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "backend": { "type": ["string", "null"] }
      }
    }
  }
}

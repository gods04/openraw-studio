{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openraw.studio/schemas/processing_preset.v1.json",
  "title": "OpenRAW Studio Processing Preset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "targets",
    "constraints",
    "confidence_gates"
  ],
  "properties": {
    "schema_version": { "const": "processing-preset.v1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "targets": {
      "type": "object",
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "confidence_gates": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}
